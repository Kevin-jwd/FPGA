(text "INPUTS\nclk: W5, 100 MHz\nrst: R2, SW15 (active high)\nbtn[0]: W19, LEFT\nbtn[1]: T17, RIGHT\nbtn[2]: T18, UP\nbtn[3]: U17, DOWN\nsw[7:0]: SW7..SW0 (unused in RTL)" (at 25 60 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "097e4d89-b200-4a88-8e7a-7280f116d24e"))
(text "DISPLAY\nan[0..3]: digit enables\nseg[0..6]: a,b,c,d,e,f,g\nseg[7]: decimal point\nBoth outputs are active low." (at 305 60 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "7c73382a-923d-4185-97a4-595d63d8c950"))
(text "LED OUTPUTS\nled[15:13]: mode code\nCLOCK=000, STOP_WATCH=001\nSTART=010, STOP=100, IDLE=111\nled[12:0]: as assigned in RTL" (at 305 120 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9061372e-1833-48dc-b7fb-b9962e551534"))
(text "This is an I/O assignment view of the implemented RTL, not a complete FPGA device symbol.\nPower, configuration, decoupling, board switches, LED resistors and display drivers belong to the existing Basys3 board.\nThe FPGA package pin numbers shown at the symbol are taken directly from the project XDC." (at 25 250 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "1d4c5f09-3055-4758-ac0f-bf5bb17f94af"))
          

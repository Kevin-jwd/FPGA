(text "u_btnD_debouncer\nDOWN / stop" (at 247 182 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "864502a6-7fb1-4e66-ba19-8e8010754392"))
(text "EACH CHANNEL\nBTN -> r_sync1 -> r_sync2 -> stable-state counter -> CLEAN_BTN\nTwo flip-flop synchronizer, then DEBOUNCE_LIMIT = 999,999 (approximately 10 ms at 100 MHz).\nAsynchronous active-high reset clears synchronizer, counter, stored state, and output." (at 25 220 0) (effects (font (size 1.7 1.7)) (justify left top)) (uuid "f55646c7-46d4-4647-a3f5-4325ce79ea0f"))
(text "The four clean_btn bits feed main_controller, where rising edges are detected using r_prev_btn.\nThe reset input is SW15 (R2), as constrained by the current project; it is not the center button." (at 25 254 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "c015da1a-3b17-4a85-bfbe-2fb64388186f"))
          
          (embedded_fonts no))
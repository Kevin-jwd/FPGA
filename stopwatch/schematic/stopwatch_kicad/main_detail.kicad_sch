(label "SEG_DATA[13..0]" (at 316.27 168.0 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6faccd0e-2620-4aba-98a4-d8571a64bc35"))
(text "MODE / BUTTON PRIORITY\nReset -> CLOCK (000). Rising edges: LEFT -> STOP_WATCH (001); RIGHT -> CLOCK.\nUP -> START (010) if mode != CLOCK. DOWN -> STOP (100) only from START.\nIDLE (111) and DELAY_CNT=5000 are declared but no transition/delay logic uses them." (at 20 216 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "233cd2e5-d540-4e5c-9e95-e3d7cae8f6f1"))
(text "COUNTERS / DISPLAY\nClock counters advance regardless of mode: MS_CNT=1000, SEC_CNT=60, MIN_CNT=100.\nSTOP_WATCH clears watch counters; START updates them; STOP holds them. Limits: watch_ms=1000, watch_sec=100.\nseg_data = CLOCK ? (min * 100 + sec) : (watch_sec * 100 + watch_ms / 10)." (at 20 244 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "b4f18777-7c24-4edd-b6d9-2e958e8fd453"))
(text "LED[15:13] = mode code.\nCLOCK: LED[12:6] = minutes, LED[5:0] = seconds.\nSTART: LED[7:0] = watch_ms / 100.\nOther unassigned LED bits retain their RTL behavior." (at 210 106 0) (effects (font (size 1.35 1.35)) (justify left top)) (uuid "66871f3a-d002-42f4-ad89-7150028105ca"))
(text "Existing RTL assignments are preserved; this drawing does not assert corrected counter rollover or reset behavior." (at 20 272 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "f01fd1a0-d76b-4f33-b421-af612a92ed08"))
          
          (embedded_fonts no))
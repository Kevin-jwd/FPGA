(text "DECIMAL CONVERSION\nd1 = in_data % 10\nd10 = (in_data / 10) % 10\nd100 = (in_data / 100) % 10\nd1000 = (in_data / 1000) % 10" (at 25 210 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "2b436fc5-154e-47b2-8da4-65f9ff1a15b6"))
(text "DIGIT MULTIPLEXER\nsel=0: d1, AN=1110\nsel=1: d10, AN=1101\nsel=2: d100, AN=1011\nsel=3: d1000, AN=0111" (at 150 210 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "6da7ddcd-5048-44bd-ab4d-2a270dfaffa5"))
(text "DECIMAL POINT\nBlink toggles every 500 ticks (0.5 s).\nSEG[7] = blink only at sel=2.\nThe clk port in fnd_digit_select is unused.\nDigit select is clocked by posedge tick." (at 275 210 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "aab6f762-1872-4911-a3d5-42a0562076e7"))
          
